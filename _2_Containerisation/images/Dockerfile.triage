FROM python:3.12-slim

WORKDIR /app

# requirements.txt is at the project root (build context)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the three scripts from a_Monday/
COPY servers/secure_triage_api.py ./servers/
COPY modules/auth.py ./modules/
COPY modules/rate_limit.py ./modules/

# So `import k_auth` and friends resolve as top-level modules
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "servers.secure_triage_api:app", "--host", "0.0.0.0", "--port", "8000"]